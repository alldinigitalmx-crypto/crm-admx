generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- CLIENTES ----------
model Cliente {
  id                 Int             @id @default(autoincrement())
  etiqueta           Etiqueta?
  nombre             String
  pais               String?
  telefono           String?
  email              String?
  notas              String?
  medioCaptacion     MedioCaptacion?
  codigoReferido     String?         @unique
  creadoEn           DateTime        @default(now())
  // Portal del cliente (Fase 1) — credenciales propias, separadas del panel admin
  passwordHash       String?
  portalActivo       Boolean         @default(false)
  ultimoAccesoPortal DateTime?
  servicios          Servicio[]
  ventasReferidas    Venta[]
  quejas             Queja[]
  cotizaciones       Cotizacion[]
}

// ---------- SERVICIOS (desarrollo a la medida) ----------
model Intermediario {
  id        Int        @id @default(autoincrement())
  nombre    String
  telefono  String?
  email     String?
  notas     String?
  creadoEn  DateTime   @default(now())
  servicios Servicio[]
}

model Servicio {
  id                      Int            @id @default(autoincrement())
  fechaInicio             DateTime
  fechaFin                DateTime?
  clienteId               Int
  cliente                 Cliente        @relation(fields: [clienteId], references: [id])
  descripcion             String
  detalles                String?
  montoInicial            Decimal        @db.Decimal(12, 2)
  moneda                  Moneda?
  intermediarioId         Int?
  intermediario           Intermediario? @relation(fields: [intermediarioId], references: [id])
  porcentajeIntermediario Decimal?       @db.Decimal(5, 2)
  status                  StatusServicio @default(Cotizado)
  tokenPublico            String         @unique @default(uuid())
  creadoEn                DateTime       @default(now())
  actualizadoEn           DateTime       @updatedAt
  creadoPorId             Int?
  creadoPor               Usuario?       @relation("ServicioCreadoPor", fields: [creadoPorId], references: [id])
  editadoPorId            Int?
  editadoPor              Usuario?       @relation("ServicioEditadoPor", fields: [editadoPorId], references: [id])
  responsableId           Int?
  responsable             Usuario?       @relation("ServicioResponsable", fields: [responsableId], references: [id])
  ordenesCambio           OrdenCambio[]
  pagos                   Pago[]
  cotizaciones            Cotizacion[]
  quejas                  Queja[]
  tareas                  Tarea[]
}

model OrdenCambio {
  id            Int               @id @default(autoincrement())
  servicioId    Int
  servicio      Servicio          @relation(fields: [servicioId], references: [id])
  descripcion   String
  monto         Decimal           @db.Decimal(12, 2)
  status        StatusOrdenCambio @default(Pendiente)
  aprobadoPorId Int?
  aprobadoPor   Usuario?          @relation("OrdenCambioAprobadoPor", fields: [aprobadoPorId], references: [id])
  aprobadoEn    DateTime?
  creadoEn      DateTime          @default(now())
  cotizaciones  Cotizacion[]
}

model Pago {
  id                   Int         @id @default(autoincrement())
  servicioId           Int
  servicio             Servicio    @relation(fields: [servicioId], references: [id])
  cotizacionId         Int?
  cotizacion           Cotizacion? @relation(fields: [cotizacionId], references: [id])
  fecha                DateTime    @default(now())
  metodoPago           MetodoPago
  monto                Decimal     @db.Decimal(12, 2)
  moneda               Moneda?
  // Equivalente en pesos mexicanos cuando moneda es distinta de MXN — los
  // reportes (Reportes, Excel, PDF) siempre suman en MXN, así que sin este
  // valor un pago en USD/COP se sumaría como si fuera el mismo número de
  // pesos (ver src/lib/pago-monto.ts). Nulo cuando moneda ya es MXN/nula:
  // en ese caso el equivalente es el propio monto.
  montoMXN             Decimal?    @db.Decimal(12, 2)
  comision             Decimal?    @db.Decimal(12, 2)
  // true = "monto" es el bruto que cobró la pasarela (hay que restarle
  // comision para saber cuánto ingresó realmente) -- así se registra todo
  // pago nuevo. false = "monto" ya es lo que de verdad llegó y comision es
  // solo informativa -- así se registraban los pagos antes de este campo,
  // y se dejan así para no alterar cifras de reportes ya generados (ver
  // montoNetoEnMXN en src/lib/pago-monto.ts).
  montoIncluyeComision Boolean     @default(true)
  comprobante          String?
  // Texto libre histórico (de antes de que existiera el modelo Cuenta) —
  // se conserva solo para mostrarlo en pagos viejos; ya no se escribe.
  // El campo real es cuentaId/cuenta, de dónde de verdad entró el dinero.
  cuentaTexto          String?
  cuentaId             Int?
  cuenta               Cuenta?     @relation(fields: [cuentaId], references: [id])
  confirmado           Boolean     @default(true)
  confirmadoPorId      Int?
  confirmadoPor        Usuario?    @relation("PagoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  confirmadoEn         DateTime?
}

// ---------- COTIZACIONES (Fase 1) ----------
model Cotizacion {
  id                 Int              @id @default(autoincrement())
  // Nulo cuando la cotización todavía es de un prospecto sin registrar
  // como cliente — ver prospectoNombre.
  clienteId          Int?
  cliente            Cliente?         @relation(fields: [clienteId], references: [id])
  prospectoNombre    String?
  servicioId         Int?
  servicio           Servicio?        @relation(fields: [servicioId], references: [id])
  ordenCambioId      Int?
  ordenCambio        OrdenCambio?     @relation(fields: [ordenCambioId], references: [id])
  descripcion        String?
  detalles           String?
  token              String           @unique
  status             StatusCotizacion @default(Enviada)
  montoSubtotal      Decimal          @db.Decimal(12, 2)
  descuentoTipo      TipoDescuento?
  descuentoValor     Decimal?         @db.Decimal(12, 2)
  descuentoMotivo    String?
  montoTotal         Decimal          @db.Decimal(12, 2)
  moneda             Moneda?
  metodoPago         MetodoPago?
  fechaEmision       DateTime         @default(now())
  fechaVencimiento   DateTime?
  fechaFirma         DateTime?
  firmanteNombre     String?
  firmanteIp         String?
  fechaPago          DateTime?
  pagoConfirmado     Boolean          @default(false)
  // Si se llena, el cliente paga primero este % del total (anticipo) y el
  // resto (liquidación) al terminar, en vez de todo de una sola vez.
  porcentajeAnticipo Int?
  creadoPorId        Int?
  creadoPor          Usuario?         @relation("CotizacionCreadoPor", fields: [creadoPorId], references: [id])
  editadoPorId       Int?
  editadoPor         Usuario?         @relation("CotizacionEditadoPor", fields: [editadoPorId], references: [id])
  creadoEn           DateTime         @default(now())
  actualizadoEn      DateTime         @updatedAt
  pagos              Pago[]
  tareas             Tarea[]
}

// ---------- TAREAS ----------
model Tarea {
  id           Int            @id @default(autoincrement())
  titulo       String
  descripcion  String?
  prioridad    PrioridadTarea @default(Media)
  fechaLimite  DateTime?
  completada   Boolean        @default(false)
  completadaEn DateTime?
  servicioId   Int?
  servicio     Servicio?      @relation(fields: [servicioId], references: [id])
  cotizacionId Int?
  cotizacion   Cotizacion?    @relation(fields: [cotizacionId], references: [id])
  creadoPorId  Int?
  creadoPor    Usuario?       @relation("TareaCreadoPor", fields: [creadoPorId], references: [id])
  asignadoAId  Int?
  asignadoA    Usuario?       @relation("TareaAsignadoA", fields: [asignadoAId], references: [id])
  creadoEn     DateTime       @default(now())
  subtareas    Subtarea[]
}

model Subtarea {
  id         Int      @id @default(autoincrement())
  tareaId    Int
  tarea      Tarea    @relation(fields: [tareaId], references: [id])
  titulo     String
  completada Boolean  @default(false)
  creadoEn   DateTime @default(now())
}

// ---------- GASTOS ----------
model Gasto {
  id          Int         @id @default(autoincrement())
  descripcion String
  categoria   String
  ambito      AmbitoGasto @default(Empresa)
  monto       Decimal     @db.Decimal(12, 2)
  metodoPago  MetodoPago?
  fecha       DateTime    @default(now())
  comprobante String?
  notas       String?
  cuentaId    Int?
  cuenta      Cuenta?     @relation(fields: [cuentaId], references: [id])
  creadoPorId Int?
  creadoPor   Usuario?    @relation("GastoCreadoPor", fields: [creadoPorId], references: [id])
  creadoEn    DateTime    @default(now())
}

// ---------- CUENTAS (dónde vive el dinero: bancos, efectivo, billeteras) ----------
// Exclusivo del dueño (esAdmin) — igual que Reportes y Gastos, nunca
// otorgable a un usuario interno vía Usuarios y Accesos.
model Cuenta {
  id           Int        @id @default(autoincrement())
  alias        String
  tipo         TipoCuenta @default(Banco)
  banco        String?
  numeroCuenta String?
  clabe        String?
  swift        String?
  // Saldo con el que arrancó la cuenta antes de que el sistema empezara a
  // llevarle la cuenta a los movimientos — el disponible real es este más
  // pagos confirmados, menos gastos y retiros vinculados.
  saldoInicial Decimal    @default(0) @db.Decimal(12, 2)
  activa       Boolean    @default(true)
  notas        String?
  creadoEn     DateTime   @default(now())
  pagos        Pago[]
  gastos       Gasto[]
  retiros      Retiro[]
}

enum TipoCuenta {
  Banco
  Efectivo
  Billetera
}

// Dinero que sale de una cuenta sin ser un Gasto de negocio ni personal
// categorizado (ej. retiro en cajero, préstamo) — solo resta del saldo
// disponible de la cuenta.
model Retiro {
  id          Int      @id @default(autoincrement())
  cuentaId    Int
  cuenta      Cuenta   @relation(fields: [cuentaId], references: [id])
  fecha       DateTime @default(now())
  monto       Decimal  @db.Decimal(12, 2)
  comentario  String?
  creadoPorId Int?
  creadoPor   Usuario? @relation("RetiroCreadoPor", fields: [creadoPorId], references: [id])
  creadoEn    DateTime @default(now())
}

// ---------- ARCHIVOS ADJUNTOS (Fase 1) ----------
// Polimórfico (entidadTipo + entidadId, sin FK) para no requerir una columna
// nueva por cada entidad que necesite adjuntos.
model Archivo {
  id           Int            @id @default(autoincrement())
  entidadTipo  EntidadArchivo
  entidadId    Int
  nombre       String
  url          String
  tipo         TipoArchivo
  tamanioBytes Int?
  subidoPorId  Int?
  subidoPor    Usuario?       @relation("ArchivoSubidoPor", fields: [subidoPorId], references: [id])
  creadoEn     DateTime       @default(now())
}

// ---------- PORTAFOLIO (casos de éxito para la landing pública) ----------
// Las imágenes de cada proyecto viven en Archivo (entidadTipo: "Proyecto",
// entidadId: este id) -- mismo patrón que la evidencia de un Servicio, y
// mismo storage (Vercel Blob) para no repetir el error de guardar
// imágenes como base64 en la base de datos.
model ProyectoPortafolio {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  categoria   String?
  linkExterno String?
  destacado   Boolean  @default(false)
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  creadoPorId Int?
  creadoPor   Usuario? @relation("ProyectoPortafolioCreadoPor", fields: [creadoPorId], references: [id])
  creadoEn    DateTime @default(now())
}

// ---------- EVENTOS DEL SISTEMA (RNF-11, base desacoplada para n8n) ----------
model EventoSistema {
  id          Int      @id @default(autoincrement())
  tipo        String
  entidadTipo String
  entidadId   Int
  payload     Json
  procesado   Boolean  @default(false)
  creadoEn    DateTime @default(now())
}

// ---------- HELP DESK / QUEJAS (Fase 1) ----------
model Queja {
  id              Int            @id @default(autoincrement())
  clienteId       Int
  cliente         Cliente        @relation(fields: [clienteId], references: [id])
  servicioId      Int?
  servicio        Servicio?      @relation(fields: [servicioId], references: [id])
  categoria       CategoriaQueja
  descripcion     String
  status          StatusQueja    @default(Nueva)
  respuesta       String?
  respondidoPorId Int?
  respondidoPor   Usuario?       @relation("QuejaRespondidoPor", fields: [respondidoPorId], references: [id])
  respondidoEn    DateTime?
  asignadoAId     Int?
  asignadoA       Usuario?       @relation("QuejaAsignadoA", fields: [asignadoAId], references: [id])
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt
}

// ---------- TICKETS DE ACCESO (Fase 1) ----------
model TicketAcceso {
  id                   Int                @id @default(autoincrement())
  usuarioSolicitanteId Int
  usuarioSolicitante   Usuario            @relation("TicketSolicitante", fields: [usuarioSolicitanteId], references: [id])
  moduloSolicitado     ModuloSistema
  motivo               String
  status               StatusTicketAcceso @default(Pendiente)
  fechaSolicitud       DateTime           @default(now())
  resueltoPorId        Int?
  resueltoPor          Usuario?           @relation("TicketResueltoPor", fields: [resueltoPorId], references: [id])
  fechaResolucion      DateTime?
}

model ModuloPermiso {
  id        Int                  @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario              @relation(fields: [usuarioId], references: [id])
  modulo    ModuloSistema
  nivel     NivelPermiso
  alcance   AlcanceModuloPermiso @default(Propio)

  @@unique([usuarioId, modulo])
}

// ---------- VENTAS (productos ya hechos al público) ----------
model Producto {
  id                 Int               @id @default(autoincrement())
  nombre             String
  descripcion        String?
  categoria          CategoriaProducto @default(Plantilla)
  precio             Decimal           @db.Decimal(12, 2)
  requiereCotizacion Boolean           @default(false)
  costoReferencia    Decimal?          @db.Decimal(12, 2)
  activo             Boolean           @default(true)
  creadoEn           DateTime          @default(now())
  detalles           DetalleVenta[]
}

model Venta {
  id               Int                   @id @default(autoincrement())
  fecha            DateTime              @default(now())
  origen           OrigenVenta           @default(Manual)
  canal            CanalVenta?
  nombreComprador  String?
  emailComprador   String?
  metodoPago       MetodoPago?
  total            Decimal               @db.Decimal(12, 2)
  referidoPorId    Int?
  referidoPor      Cliente?              @relation(fields: [referidoPorId], references: [id])
  comisionReferido Decimal?              @db.Decimal(12, 2)
  tipoEntrega      TipoEntrega           @default(Inmediata)
  status           String?
  etapaActualId    Int?
  etapaActual      EtapaVenta?           @relation(fields: [etapaActualId], references: [id])
  creadoPorId      Int?
  creadoPor        Usuario?              @relation("VentaCreadoPor", fields: [creadoPorId], references: [id])
  editadoPorId     Int?
  editadoPor       Usuario?              @relation("VentaEditadoPor", fields: [editadoPorId], references: [id])
  actualizadoEn    DateTime              @updatedAt
  detalles         DetalleVenta[]
  etapaHistorial   VentaEtapaHistorial[]
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int      @default(1)
  precioUnitario Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
}

// Catálogo configurable de etapas para ventas de entrega a largo plazo (RF-76)
model EtapaVenta {
  id        Int                   @id @default(autoincrement())
  nombre    String
  orden     Int
  ventas    Venta[]
  historial VentaEtapaHistorial[]
}

model VentaEtapaHistorial {
  id              Int        @id @default(autoincrement())
  ventaId         Int
  venta           Venta      @relation(fields: [ventaId], references: [id])
  etapaId         Int
  etapa           EtapaVenta @relation(fields: [etapaId], references: [id])
  fecha           DateTime   @default(now())
  comentario      String?
  registradoPorId Int?
  registradoPor   Usuario?   @relation("VentaEtapaRegistradoPor", fields: [registradoPorId], references: [id])
}

// ---------- CATÁLOGOS ----------
enum Etiqueta {
  VIP
  Premium
  Platinum
  Prospecto
}

enum MedioCaptacion {
  FacebookAds
  Grupo
  Intermediario
  Otro
}

enum StatusServicio {
  Cotizado
  Aprobado
  EnProceso
  Entregado
  Cancelado
}

enum StatusOrdenCambio {
  Pendiente
  Aprobada
  Rechazada
}

enum MetodoPago {
  Efectivo
  Transferencia
  MercadoPago
  PayPal
  Tarjeta
  WesternUnion
  Binance
  Deposito
  Spin
  Otro
}

enum StatusCotizacion {
  Enviada
  Firmada
  Pagada
  Vencida
  Perdida
}

enum PrioridadTarea {
  Baja
  Media
  Alta
}

enum AmbitoGasto {
  Personal
  Empresa
}

enum TipoDescuento {
  Monto
  Porcentaje
}

enum EntidadArchivo {
  Servicio
  Cotizacion
  Queja
  Pago
  Proyecto
}

enum TipoArchivo {
  Imagen
  Video
  Documento
  Otro
}

enum CategoriaQueja {
  Falla
  Cobro
  Atencion
  Sugerencia
  Otro
}

enum StatusQueja {
  Nueva
  EnRevision
  Resuelta
  Cerrada
}

enum ModuloSistema {
  Clientes
  Servicios
  Cotizaciones
  Pagos
  Productos
  Ventas
  Quejas
  Usuarios
  Portal
  Tareas
  Intermediarios
  Portafolio
}

enum StatusTicketAcceso {
  Pendiente
  Aprobado
  Rechazado
}

enum NivelPermiso {
  Ver
  Crear
  Editar
}

enum AlcanceModuloPermiso {
  Propio
  Todo
}

enum TipoEntrega {
  Inmediata
  LargoPlazo
}

enum Moneda {
  MXN
  COP
  USD
  EUR
}

enum CategoriaProducto {
  Plantilla
  Sistema
  Otro
}

enum CanalVenta {
  Referido
  GrupoWhatsApp
  Directo
  Otro
}

enum OrigenVenta {
  TiendaOnline
  Manual
}

model Usuario {
  id                 Int        @id @default(autoincrement())
  email              String     @unique
  passwordHash       String
  nombre             String
  rol                RolUsuario @default(Interno)
  activo             Boolean    @default(true)
  creadoEn           DateTime   @default(now())
  resetTokenHash     String?
  resetTokenExpiraEn DateTime?

  serviciosCreados           Servicio[]            @relation("ServicioCreadoPor")
  serviciosEditados          Servicio[]            @relation("ServicioEditadoPor")
  ordenesCambioAprobadas     OrdenCambio[]         @relation("OrdenCambioAprobadoPor")
  pagosConfirmados           Pago[]                @relation("PagoConfirmadoPor")
  cotizacionesCreadas        Cotizacion[]          @relation("CotizacionCreadoPor")
  cotizacionesEditadas       Cotizacion[]          @relation("CotizacionEditadoPor")
  archivosSubidos            Archivo[]             @relation("ArchivoSubidoPor")
  quejasRespondidas          Queja[]               @relation("QuejaRespondidoPor")
  ticketsSolicitados         TicketAcceso[]        @relation("TicketSolicitante")
  ticketsResueltos           TicketAcceso[]        @relation("TicketResueltoPor")
  moduloPermisos             ModuloPermiso[]
  ventasCreadas              Venta[]               @relation("VentaCreadoPor")
  ventasEditadas             Venta[]               @relation("VentaEditadoPor")
  ventaEtapaHistorial        VentaEtapaHistorial[] @relation("VentaEtapaRegistradoPor")
  tareasCreadas              Tarea[]               @relation("TareaCreadoPor")
  gastosCreados              Gasto[]               @relation("GastoCreadoPor")
  proyectosPortafolioCreados ProyectoPortafolio[]  @relation("ProyectoPortafolioCreadoPor")
  serviciosResponsable       Servicio[]            @relation("ServicioResponsable")
  tareasAsignadas            Tarea[]               @relation("TareaAsignadoA")
  quejasAsignadas            Queja[]               @relation("QuejaAsignadoA")
  retirosCreados             Retiro[]              @relation("RetiroCreadoPor")
}

enum RolUsuario {
  Admin
  Interno
}
